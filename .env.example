# .env.example – Beispiel für lokale Entwicklung
# --------------------------------------------------
# Dieses File zeigt alle notwendigen Umgebungsvariablen
# für die Entwicklungsumgebung (APP_ENV=dev). Kopiere
# es zu ".env" und passe sensible Werte an!
# --------------------------------------------------

# 1) Environment / Mode
# ---------------------
# APP_ENV steuert Modus-spezifisches Verhalten:
# • "dev":  Aktiviert Debugging und Auto-Reload
# • "prod": Deaktiviert Debug, setzt optimierte Einstellungen
APP_ENV=dev

# 2) Server / Host Settings
# -------------------------
# HOST & PORT definieren, wo der ASGI-Server (Uvicorn)
# lauscht. Ändere HOST auf "0.0.0.0" für Docker-Netzwerke.
HOST=127.0.0.1
PORT=8000

# 3) Database Configuration
# -------------------------
# MariaDB-Zugangsdaten für Entwicklung. Ersetze USER/PASS
# und DB_NAME durch deine lokalen Werte.
DB_ROOT_PASSWORD=changeme                 # Root-Passwort für Initialisierung
DB_USER=dev_user                          # Runtime-User (nur Lese/Schreib)
DB_PASSWORD=dev_pass                      # Passwort des Runtime-Users
DB_MIGRATE_USER=dev_migrate               # Migrations-User (DDL-Rechte)
DB_MIGRATE_PASSWORD=dev_migrate_pass      # Passwort des Migrations-Users
DB_HOST=localhost                         # Hostname oder IP der DB
DB_PORT=3306                              # Port (Standard MariaDB/MySQL)
DB_NAME=museum_db_dev                     # Name der Entwicklungsdatenbank

# Connection-Strings – werden aus den obigen Variablen zusammengesetzt
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL_MIGRATE=mysql+pymysql://${DB_MIGRATE_USER}:${DB_MIGRATE_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# 4) CORS & Security
# ------------------
# CORS_ALLOWED_ORIGINS: durch Kommas getrennte Liste erlaubter Origins.
# "*" erlaubt alle – gut für Dev, in Prod bitte einschränken!
CORS_ALLOWED_ORIGINS=*
# SECRET_KEY: Zufälliger String für Token-Signaturen – unbedingt ändern!
SECRET_KEY=dev-secret
# Token-Life: Zeit in Minuten, wie lange Access-Tokens gültig bleiben
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 5) Logging
# ----------
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# LOG_FORMAT: Format-String für das Python-Logging-Modul
LOG_FORMAT=%(levelname)s:%(name)s:%(message)s

# 6) Media / Static Files
# -----------------------
# Pfad im Container, unter dem eure Media-Dateien liegen (kann gemountet werden)
MEDIA_STATIC_PATH=/app/static
# URL-Prefix, unter dem FastAPI die Static-Files bereitstellt
MEDIA_URL=/static

# 7) Externe Integrationen & Feature-Flags
# -----------------------------------------
# URL für die Wikipedia-API (kann angepasst werden, z.B. Sprachversion)
WIKIPEDIA_API_URL=https://de.wikipedia.org/api/rest_v1
# Feature-Flag: Thumbnail-Generierung aktivieren/deaktivieren
FEATURE_THUMBNAILS=true
