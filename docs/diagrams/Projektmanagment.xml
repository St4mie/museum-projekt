        <mxCell id="orgText" value="• Agile Entwicklung mit Sprints zur Planung &amp; Strukturierung\n• Aufgabenmanagement via GitHub Issues / Backlog\n• Klare Rollenverteilung:\n  - Entwickler: Volle Rechte für Migrationen\n  - Museum: Content-Management (CRUD)\n  - Service: Import &amp; API-Funktionen\n• Regelmäßige Team-Meetings zur Fortschrittskontrolle\n• Dokumentation in Markdown-Dateien" style="text;html=1;align=left;fontSize=12;whiteSpace=wrap;" vertex="1" parent="lane1">
          <mxGeometry x="10" y="30" width="280" height="150" as="geometry"/>
        </mxCell>

