          <mxGeometry x="340" y="80" width="300" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="devText" value="• Git-Workflow: Feature‑Branches → Merge in main nach Sprint\n• Keine formalen Code-Reviews – eigenverantwortlich\n• Schemaänderungen mit Alembic versioniert\n• Modulare Architektur:\n  - FastAPI für Backend\n  - SQLAlchemy ORM für Datenbankzugriff\n  - Pydantic für Datenvalidierung\n• Pre-Commit-Hooks für Codequalität (Flake8, MyPy)\n• Klare Projektstruktur mit Trennung von API, Models, Services" style="text;html=1;align=left;fontSize=12;whiteSpace=wrap;" vertex="1" parent="lane2">
          <mxGeometry x="10" y="30" width="280" height="180" as="geometry"/>
        </mxCell>

